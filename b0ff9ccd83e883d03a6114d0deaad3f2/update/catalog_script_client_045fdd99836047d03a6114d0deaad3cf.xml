        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var splited = newValue.split('/');
    var date = new Date(Number(splited[2]), Number(splited[1] - 1), Number(splited[0]), 0, 0, 0, 0);
    var today = new Date();
    if (date > today) {
        g_form.addErrorMessage("Date can't be after today");
        g_form.setValue("spent_date", "");
    } else {
        g_form.clearMessages();
    }

}]]></script>
